                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "New Value"
          }
        },
        "type": "object",
        "required": [
          "id",
          "ts",
          "actor",
          "key"
        ],
        "title": "ConfigAuditItem"

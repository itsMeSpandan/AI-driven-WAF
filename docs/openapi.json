            "description": "Category: sqli, xss, bot_anomaly, etc."
          },
          "count": {
            "type": "integer",
            "title": "Count",
            "description": "Number of occurrences"
          },
          "percentage": {
            "type": "number",
            "title": "Percentage",
            "description": "Percentage of total attacks"
          }
        },
        "type": "object",
        "required": [
          "attack_type",
          "count",
          "percentage"
        ],
        "title": "AttackTypeItem"
      },
      "AttackTypeResponse": {
        "properties": {
          "total_attacks": {
            "type": "integer",

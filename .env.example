# WAF Gateway Configuration
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
UPSTREAM_URL=http://demo-app:3000
WAF_MODE=block                  # 'monitor' (log only) or 'block' (reject malicious)
ML_THRESHOLD=0.75               # ML score >= threshold triggers block/flag (0.0 to 1.0)
MAX_BODY_INSPECT_BYTES=16384    # 16 KB inspect cap (full body is still forwarded)
FAIL_MODE=closed                # 'open' (pass traffic if WAF fails) or 'closed' (block on internal error)

# Database Configuration
# In docker-compose, shared volume mounted at /data
DB_URL=sqlite:////data/waf.db
# For local development without Docker:
# DB_URL=sqlite:///./data/waf.db
# PostgreSQL alternative:
# DB_URL=postgresql://waf:wafpass@db:5432/waf

# Dashboard API Configuration
DASHBOARD_API_HOST=0.0.0.0
DASHBOARD_API_PORT=8000

# Dashboard UI Configuration
DASHBOARD_UI_PORT=3000
NEXT_PUBLIC_API_BASE=http://localhost:8000
